# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# E-Ink Screen Customization (Run-time environment settings)
EINK_THEME="light"            # 'light' (black-on-white) or 'dark' (white-on-black)
EINK_SCENARIO="springShowers" # 'springShowers', 'mistyMorning', or 'goldenAfternoon'
EINK_SHOW_CONTROLS="true"     # 'true' (visible) or 'false' (hidden)
EINK_HIDE_SETTINGS="false"    # 'true' = completely remove the settings footer (no restore button either)

# Home Assistant Configuration
# Uncomment and configure these to pull live data from Home Assistant
# HA_URL="http://homeassistant.local:8123"
# HA_TOKEN="your_long_lived_access_token_here"
# HA_ENTITY_WEATHER="weather.home"
# HA_ENTITY_INDOOR_TEMP="sensor.indoor_temperature"
# HA_ENTITY_INDOOR_HUMIDITY="sensor.indoor_humidity"
# HA_ENTITY_BATTERY="sensor.dashboard_battery"
# HA_ENTITY_WIFI="sensor.dashboard_wifi"
# HA_ENTITY_PM25="sensor.pm25"
# HA_ENTITY_LQI="sensor.air_quality_index"
HA_ENTITY_WEATHER_SUMMARY="sensor.eink_weather_summary"
HA_ENTITY_WEATHER_SHORT_SUMMARY="sensor.eink_weather_short_summary"
# HA_ENTITY_SUN="sun.sun"
